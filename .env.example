# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)

# 서버 포트와 화면 주소
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL 주소 (Render 의 External Database URL)
DATABASE_URL=
# 앱 테이블을 만들 스키마 이름 (기존 데이터를 건드리지 않으려고 따로 둡니다)
DB_SCHEMA=moa

# 로그인 토큰과 연결 키 암호화에 쓰는 비밀 값 (길고 무작위로)
JWT_SECRET=
ENCRYPTION_KEY=

# GPT (AI 제안 기능). 비어 있으면 미리 정해 둔 답(모의 응답)으로 동작해요.
GPT_API_KEY=
GPT_MODEL=

# 가상 데이터와 시연 기능
DEMO_MODE=true
SEED_ON_START=true
ENABLE_SCHEDULER=true

# (선택) 시연 날짜를 미리 맞출 때만 한 번 붙여서 실행해요: SEED_TODAY=2026-11-11 npm run seed:reset
# 서버 설정(.env)에는 넣지 마세요. 넣으면 처음 상태로 되돌릴 때마다 그 날짜로 만들어져요.
